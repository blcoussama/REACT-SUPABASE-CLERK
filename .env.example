# REACT-SUPABASE-CLERK (front Vite) : copier en ".env.local" à la racine du dépôt (jamais versionné).
# Toutes ces valeurs sont PUBLIQUES (envoyées au navigateur) : n'y mettez jamais de clé secrète.

# Clerk Dashboard > Configure > API keys > Publishable key (pk_test_... / pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase Dashboard > Project Settings > API : Project URL et clé "anon" / publishable
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
