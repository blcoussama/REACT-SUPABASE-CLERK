# Secrets de l'Edge Function "set-role" (supabase/functions/set-role).
# En production : supabase secrets set CLERK_SECRET_KEY=... ALLOWED_ORIGINS=...
# En local (supabase functions serve) : copier en "supabase/functions/.env" (jamais versionné).

# Clerk Dashboard > Configure > API keys > Secret key (sk_test_... / sk_live_...) : SECRET, jamais côté front
CLERK_SECRET_KEY=

# Origines du front autorisées (CORS + claim "azp" du jeton Clerk), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173
